{
  "name": "neptune-digital-twin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:drive": "vite --config vite.drive.config.js",
    "build": "vite build",
    "build:drive": "vite build --config vite.drive.config.js",
    "build:server": "vite build --mode server",
    "preview": "vite preview",
    "add-asset": "node scripts/add-asset.mjs",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:drive-api": "node scripts/dev-drive-api.mjs",
    "test:worker": "node --test scripts/test-worker.mjs",
    "test:accounts-ui": "node --test scripts/test-accounts-ui.mjs",
    "test:premium-ui": "node --test scripts/test-premium-ui.mjs",
    "test:shoring-ui": "node --test scripts/test-shoring-ui.mjs",
    "test:rows-ui": "node --test scripts/test-rows-ui.mjs",
    "test:site-items-ui": "node --test scripts/test-site-items-ui.mjs",
    "test:plant-ui": "node --test scripts/test-plant-ui.mjs",
    "test:drive-worker": "node --test scripts/test-drive-worker.mjs",
    "test:drive-ui": "node --test scripts/test-drive-ui.mjs",
    "test:drive-pro-ui": "node --test scripts/test-drive-pro-ui.mjs",
    "deploy": "vite build --mode cloudflare && wrangler deploy",
    "deploy:cloudflare": "wrangler d1 migrations apply DB --remote && npm run deploy",
    "deploy:drive": "wrangler d1 migrations apply DB --remote -c wrangler.drive.jsonc && vite build --config vite.drive.config.js && wrangler deploy -c wrangler.drive.jsonc"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "3d-tiles-renderer": "^0.5.3",
    "lil-gui": "^0.21.0",
    "three": "^0.186.1",
    "three-mesh-bvh": "0.9.16"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.5",
    "wrangler": "^4.156.0"
  }
}
