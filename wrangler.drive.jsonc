// World Drive on worlddrive.app (docs/world-drive.md): its own Worker, apart from the construction
// app's (wrangler.jsonc). `npm run deploy:drive` applies the leaderboard's migrations, builds the
// site into dist-drive/ and deploys it with this; Workers Builds runs the same from GitHub.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "world-drive",
	"main": "worker/drive/index.js",
	"compatibility_date": "2026-10-01",
	// The built site (npm run build:drive). The Worker only runs for /api/*; everything else is
	// served straight from these files, which costs nothing however many people visit.
	"assets": {
		"directory": "./dist-drive",
		"binding": "ASSETS",
		"run_worker_first": [ "/api/*" ]
	},
	// Both addresses are the Worker's custom domains (Cloudflare makes their DNS records and
	// certificates). www sends you on to worlddrive.app (worker/drive/index.js and the page itself).
	"routes": [
		{ "pattern": "worlddrive.app", "custom_domain": true },
		{ "pattern": "www.worlddrive.app", "custom_domain": true }
	],
	// No second address on workers.dev: the Turnstile widget only works on worlddrive.app, and one
	// address keeps the visit counts simple.
	"workers_dev": false,
	"preview_urls": false,
	// Settings in the dashboard (Settings → Variables and Secrets) that aren't listed here survive a
	// deploy. The ones below are set from here on every deploy: change them here, not there.
	"keep_vars": true,
	"vars": {
		// Visits a day for everyone together, and for each visitor; both start again at midnight UTC.
		// Each visit is one billed Google Maps session.
		"DAILY_VISITS": "300",
		"PER_VISITOR_DAILY": "8",
		// The Turnstile widget for worlddrive.app (public; its secret is the TURNSTILE_SECRET secret).
		"TURNSTILE_SITE_KEY": "0x4AAAAAAFs3k5sgUIQHSuGC",
		// The Supporter Pass (docs/world-drive.md, worker/drive/supporter.js), all public: a supporter's
		// visits a day; the "Sign in with Google" button's OAuth client id (empty: no signing in and no
		// buying, and the pass says "Coming soon"); the Payment Link, in World Drive's own Stripe
		// account, and its price as the page shows it.
		"PER_VISITOR_DAILY_SUPPORTER": "30",
		"GOOGLE_CLIENT_ID": "979605278581-il852i6ql3e6j2t1kobqo2bg46pkaii5.apps.googleusercontent.com",
		"SUPPORTER_PAYMENT_LINK": "https://buy.stripe.com/9B6bJ0fSYaMf3nc0cCfrW00",
		"SUPPORTER_PRICE": "CA$4.99"
	},
	// Secrets, set by the owner and never in a file (the dashboard, or
	// npx wrangler secret put GOOGLE_MAPS_API_KEY -c wrangler.drive.jsonc): GOOGLE_MAPS_API_KEY (a
	// secret named Google_maps_api, in any case, is taken too), TURNSTILE_SECRET, and for the
	// Supporter Pass STRIPE_WEBHOOK_SECRET (the live webhook endpoint's whsec_... signing secret;
	// buying stays off without it) and, if wanted, SUPPORTER_EMAILS (comma-separated: the pass
	// without paying). Locally they come from .dev.vars.drive (.dev.vars.drive.example).
	//
	// The day's visit counts and the search queue: one Durable Object for everyone, on SQLite storage
	// (on every plan, the free one too).
	"durable_objects": {
		"bindings": [ { "name": "LIMITS", "class_name": "DriveLimits" } ]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": [ "DriveLimits" ] }
	],
	// The leaderboard: nicknames and each player's best stunt scores (worker/drive/scores.js). The
	// world-drive database already exists; its tables are worker/drive/migrations, applied by the
	// deploy (`npm run deploy:drive`, which Workers Builds runs) before the Worker goes out.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "world-drive",
			"database_id": "097e0573-c9ac-4359-8551-2ef89762bd55",
			"migrations_dir": "worker/drive/migrations"
		}
	]
}
