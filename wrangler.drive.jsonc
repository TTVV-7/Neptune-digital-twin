// World Drive on worlddrive.app (docs/world-drive.md): its own Worker, apart from the construction
// app's (wrangler.jsonc). `npm run deploy:drive` applies the leaderboard's migrations, builds the
// site into dist-drive/ and deploys it with this; Workers Builds runs the same from GitHub.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "world-drive",
	"main": "worker/drive/index.js",
	"compatibility_date": "2026-10-01",
	// The built site (npm run build:drive). The Worker only runs for /api/*, /c, the path a
	// "challenge a friend" link is shared at (/c?challenge=...: the page with its own preview card for
	// chat apps), and /ads.txt (AdSense's, made from ADSENSE_CLIENT below; a 404 while that's empty);
	// everything else, the home page included, is served straight from these files, which
	// costs nothing however many people visit, and goes on being served on the Free plan when the
	// day's 100,000 Worker requests are used up (a path the Worker runs first for gets a 429 then).
	"assets": {
		"directory": "./dist-drive",
		"binding": "ASSETS",
		"run_worker_first": [ "/api/*", "/c", "/ads.txt" ]
	},
	// Both addresses are the Worker's custom domains (Cloudflare makes their DNS records and
	// certificates). www sends you on to worlddrive.app (worker/drive/index.js and the page itself).
	"routes": [
		{ "pattern": "worlddrive.app", "custom_domain": true },
		{ "pattern": "www.worlddrive.app", "custom_domain": true }
	],
	// No second address on workers.dev: the Turnstile widget only works on worlddrive.app, and one
	// address keeps the visit counts simple.
	"workers_dev": false,
	"preview_urls": false,
	// Settings in the dashboard (Settings → Variables and Secrets) that aren't listed here survive a
	// deploy. The ones below are set from here on every deploy: change them here, not there.
	"keep_vars": true,
	"vars": {
		// Earth visits a day for everyone together, and for each visitor (one: past it, or past the day's
		// cap, the page opens on the Moon, which costs nothing); both start again at midnight UTC.
		// Each visit is one billed Google Maps session.
		"DAILY_VISITS": "300",
		"PER_VISITOR_DAILY": "1",
		// The Turnstile widget for worlddrive.app (public; its secret is the TURNSTILE_SECRET secret).
		"TURNSTILE_SITE_KEY": "0x4AAAAAAFs3k5sgUIQHSuGC",
		// The Supporter Pass (docs/world-drive.md, worker/drive/supporter.js), all public: a supporter's
		// visits a day; the "Sign in with Google" button's OAuth client id (empty: no signing in and no
		// buying, and the pass says "Coming soon"); the Payment Link, in World Drive's own Stripe
		// account, and its price as the page shows it.
		"PER_VISITOR_DAILY_SUPPORTER": "30",
		"GOOGLE_CLIENT_ID": "979605278581-il852i6ql3e6j2t1kobqo2bg46pkaii5.apps.googleusercontent.com",
		"SUPPORTER_PAYMENT_LINK": "https://buy.stripe.com/9B6bJ0fSYaMf3nc0cCfrW00",
		"SUPPORTER_PRICE": "CA$2/month",
		// Driving with others (worker/drive/live.js): "off" is the kill switch. New connections are
		// turned away, those already in a room are closed as they next say anything (or at the room's
		// next alarm) once the room runs the new version (a busy one can take up to 5 minutes to; see
		// docs/world-drive.md, "Switching it off"), and the page drives alone.
		"LIVE": "on",
		// Its budget: the Durable Object requests a day it may use (UTC days), then it switches itself
		// off until midnight UTC, the same way, with a toast that it's back then. Rooms are billed by
		// the message: an hour driving with others is about 900 requests (5 a second, billed 20 to a
		// request), and a driver alone in a room sends only a keepalive. On the Free plan every
		// Durable Object fails for the rest of the day once all of them together pass 100,000,
		// DriveLimits' visit counts included, and then nobody could start a drive: 40,000 leaves the
		// rest for those, with room for the minute the rooms' counts can run behind. On Workers Paid,
		// past the million a month included, requests are $0.15 a million: each 100,000 a day more is
		// 3 million a month, $0.45 (docs/world-drive.md, "What it costs"). 0 is off.
		"LIVE_DAILY_BUDGET": "40000",
		// Google AdSense (docs/world-drive.md, "Ads"): one banner on the globe, never while driving and
		// never for a supporter. ADSENSE_CLIENT is the publisher id, "ca-pub-" and 16 digits (public);
		// empty, no ads at all: nothing about them is loaded or shown, and /ads.txt is a 404.
		// ADSENSE_SLOT is a display ad unit's id (6 to 12 digits), or empty for a responsive unit with
		// none. Either one not in its format switches ads off.
		"ADSENSE_CLIENT": "ca-pub-7954356723512335",
		"ADSENSE_SLOT": ""
	},
	// Secrets, set by the owner and never in a file (the dashboard, or
	// npx wrangler secret put GOOGLE_MAPS_API_KEY -c wrangler.drive.jsonc): GOOGLE_MAPS_API_KEY (a
	// secret named Google_maps_api, in any case, is taken too), TURNSTILE_SECRET, and for the
	// Supporter Pass STRIPE_WEBHOOK_SECRET (the live webhook endpoint's whsec_... signing secret;
	// buying stays off without it) and, if wanted, SUPPORTER_EMAILS (comma-separated: the pass
	// without paying). Locally they come from .dev.vars.drive (.dev.vars.drive.example).
	//
	// The day's visit counts and the search queue: one Durable Object for everyone, on SQLite storage
	// (on every plan, the free one too), with what driving with others has spent of today's budget.
	// And the rooms for driving with others: one Durable Object a room, a party (the friends who
	// opened its link) or the drivers in one area about 11 km across, holding everyone's WebSocket and
	// telling them where the others are. A room stores nothing but its alarm (about once a minute
	// while anyone's in it, when it may add what it has spent to the day's), and hibernates between
	// messages; SQLite-backed for the free plan as well.
	"durable_objects": {
		"bindings": [
			{ "name": "LIMITS", "class_name": "DriveLimits" },
			{ "name": "ROOMS", "class_name": "DriveRoom" }
		]
	},
	// Each visit's connections to the rooms, at most 20 a minute (worker/drive/live.js): a loop of
	// them is turned away before it costs a Durable Object request. Cloudflare's rate limiter counts
	// in each of its locations, roughly; the namespace is this account's own number for it.
	"ratelimits": [
		{ "name": "LIVE_CONNECTS", "namespace_id": "4801", "simple": { "limit": 20, "period": 60 } },
		// Each player's reports of what they drove, for their XP (worker/drive/progress.js), and title
		// changes: at most 10 a minute (a page reports every couple of minutes). On the rate limiter
		// rather than DriveLimits, so levels cost no Durable Object request at all.
		{ "name": "PROGRESS_POSTS", "namespace_id": "4802", "simple": { "limit": 10, "period": 60 } },
		{ "name": "STATS_POSTS", "namespace_id": "4803", "simple": { "limit": 6, "period": 60 } },
		// The owner's admin page's asks (worker/drive/admin.js), by account: each reads a period's rows
		// from D1, so at most 30 a minute (the page asks once or twice a change of period).
		{ "name": "ADMIN_LOOKS", "namespace_id": "4804", "simple": { "limit": 30, "period": 60 } },
		// A visitor's sign-ins with a password, checks of one and changes to an account
		// (worker/drive/logins.js), by the challenges' keyed hash of the address (an IPv6 one by its
		// /48) and the day: at most 10 a minute, room for a few mistyped passwords and a change, while
		// a script trying over and over is turned away before each try costs a Durable Object request.
		{ "name": "PASSWORD_TRIES", "namespace_id": "4807", "simple": { "limit": 10, "period": 60 } },
		// The challenges' lists, boards and times posted (worker/drive/challenges.js), by address (an
		// IPv6 one by its /48), each counted by an HMAC of it and the day (lookKey), never as it is: a
		// page asks a few times a minute at most (the list as it opens, a board or two, a time); a
		// script asking over and over is turned away before it reads D1.
		{ "name": "CHALLENGE_LOOKS", "namespace_id": "4805", "simple": { "limit": 60, "period": 60 } },
		// Those of the lists and boards that miss Cloudflare's cache and read D1 (a board's rows, the
		// list's tops, a player's own rows, a board's order), and the times posted (each reads D1 before
		// the gap can turn it away), by the same key: 10 a minute, room for a page's list, all six
		// boards and a time, while one address asking for past boards or players, or posting, in turn
		// costs a few hundred thousand rows read a day at most (docs/world-drive.md, "What challenges
		// cost").
		{ "name": "CHALLENGE_MISSES", "namespace_id": "4806", "simple": { "limit": 10, "period": 60 } },
		// A visitor's asks for their achievements (worker/drive/achievements.js), by the same key: each
		// reads about 30 rows for most players and about 410 at most for a big account
		// (docs/world-drive.md, "What it costs"), and a page asks as its Achievements grid opens, so 6
		// a minute (and ACHIEVEMENT_LOOKS_PER_VISITOR_DAILY, 200, a day by DriveLimits).
		{ "name": "ACHIEVEMENT_LOOKS", "namespace_id": "4808", "simple": { "limit": 6, "period": 60 } }
	],
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": [ "DriveLimits" ] },
		{ "tag": "v2", "new_sqlite_classes": [ "DriveRoom" ] }
	],
	// The leaderboard: nicknames and each player's best stunt scores (worker/drive/scores.js), and
	// each player's XP for levels (worker/drive/progress.js). The world-drive database already
	// exists; its tables are worker/drive/migrations, applied by the deploy (`npm run deploy:drive`, which Workers Builds runs) before the Worker goes out.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "world-drive",
			"database_id": "097e0573-c9ac-4359-8551-2ef89762bd55",
			"migrations_dir": "worker/drive/migrations"
		}
	]
}
