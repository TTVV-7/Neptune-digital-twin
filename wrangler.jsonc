// The app on Cloudflare Workers, with sign-in and layouts saved to your account
// (docs/accounts.md). `npm run deploy` builds the site and deploys it with this. The same API
// also runs on Vercel (vercel.json, docs/deploy-vercel.md).
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "neptune-twin-app",
	"main": "worker/index.js",
	"compatibility_date": "2026-10-01",
	// The built site (npm run build). The Worker only runs for /api/*; everything else is
	// served straight from these files.
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": [ "/api/*" ]
	},
	// Settings are kept in the Worker's dashboard (Settings → Variables and Secrets), not here, so
	// a deploy from GitHub (Workers Builds) never blanks them; keep_vars keeps them across deploys.
	// Plain text: GOOGLE_CLIENT_ID (the "Web application" OAuth client id, not secret),
	// ALLOWED_EMAILS and ALLOWED_DOMAINS (comma-separated; both empty lets any Google account in),
	// and for premium (docs/premium.md) STRIPE_PAYMENT_LINK, STRIPE_PAYMENT_LINK_ID, PREMIUM_PRICE,
	// PREMIUM_EMAILS. Locally they come from .dev.vars (.dev.vars.example).
	"keep_vars": true,
	// Secrets: npx wrangler secret put GOOGLE_MAPS_API_KEY (and STRIPE_WEBHOOK_SECRET for premium)
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "neptune-twin-app",
			// Made with `npx wrangler d1 create neptune-twin-app`. Its tables are worker/migrations,
			// applied by the deploy (Workers Builds runs `npm run deploy:cloudflare`).
			"database_id": "752bc4f8-6114-4d38-929e-ac734e8176e0",
			"migrations_dir": "worker/migrations"
		}
	]
}
