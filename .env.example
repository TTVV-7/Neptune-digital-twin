# Copy this file to .env.local and paste your key.
# Google Cloud console: enable "Map Tiles API" and restrict the key to your site's origin with
# no path, e.g. http://localhost:5173/* and https://yourname.github.io/*
# GOOGLE_MAPS_API_KEY set in your shell or cloud environment works too.
VITE_GOOGLE_MAPS_API_KEY=

# World Drive's contact page and policies (drive/site/legal.js; docs/world-drive.md, "Legal pages"):
# who runs it and how to reach them, shown at /contact/ and in the policies. Kept out of git here;
# for the live site, set them as build variables where the site is built. The build warns while any
# is missing: consumer law and Stripe ask for all four before taking payments.
DRIVE_CONTACT_NAME=
DRIVE_CONTACT_ADDRESS=
DRIVE_CONTACT_PHONE=
DRIVE_CONTACT_EMAIL=
