# Copy this file to .env.local and paste your key.
# Google Cloud console: enable "Map Tiles API" and restrict the key to your site's URL.
# GOOGLE_MAPS_API_KEY set in your shell or cloud environment works too.
VITE_GOOGLE_MAPS_API_KEY=

# Live ships: a free key from https://aisstream.io (sign in with GitHub, then create a key under Account).
# It stays on the dev server and is never sent to the browser.
AISSTREAM_API_KEY=
